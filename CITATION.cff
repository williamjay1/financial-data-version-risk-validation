    given-names: Junjie
    orcid: "https://orcid.org/0009-0004-8821-4018"
    affiliation: "Shanghai International Studies University"
type: software
license: MIT
keywords:
  - model validation
  - model risk
  - credit risk
  - bankruptcy prediction
  - data versioning
  - backtesting
